# CMake build directory
build/

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Editor and IDE artefacts
.vscode/
.idea/
*.swp
*.swo
*~

# macOS metadata
.DS_Store

# Pico SDK (fetched separately — not part of this repo)
pico-sdk/

# Build areas (./build puts every build tree under builds/ and the .uf2
# images in kits/).  Both directories are kept in the repo by a .gitkeep;
# nothing else in them is tracked.
builds/*
!builds/.gitkeep
kits/*
!kits/.gitkeep

# Log files from the console tool
*.log

# Cache
.cache/


# Hardware test run logs and stack reports (hwtest/run.py)
hwtest/logs/
